  <MdxScripts>
    <MdxScript dwd:design-time-name="96deeba4-3480-43dd-acc5-13dacf0419fa">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE; 
CREATE DYNAMIC SET CURRENTCUBE.[Employees &lt; 2 Years]
 AS Filter(
    [Dim Employee].[Full Name].Members,
    [Measures].[Experience Years] &lt; 2
) ; 
CREATE DYNAMIC SET CURRENTCUBE.[Employees 2-4 Years]
 AS Filter(
    [Dim Employee].[Full Name].Members,
    [Measures].[Experience Years] &gt;= 2 AND [Measures].[Experience Years] &lt;= 4
) ; 
CREATE DYNAMIC SET CURRENTCUBE.[Employees &gt; 4 Years]
 AS Filter(
    [Dim Employee].[Full Name].Members,
    [Measures].[Experience Years] &gt; 4
) ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Performance Rating]
 AS IIF(
    [Measures].[Fact HR Count] = 0,
    NULL,
    [Measures].[Performance Rating] / [Measures].[Fact HR Count]
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Salary INR]
 AS IIF(
    [Measures].[Fact HR Count] = 0,
    NULL,
    [Measures].[Salary INR] / [Measures].[Fact HR Count]
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Max Salary INR]
 AS Max(
    [Dim Employee].[Full Name].Members,
    [Measures].[Salary INR]
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Min Salary INR]
 AS Min(
    NonEmpty(
        [Dim Employee].[Full Name].Members,
        [Measures].[Salary INR]
    ),
    [Measures].[Salary INR]
), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Level Number]
 AS [Dim Location].[Hierarchy].CurrentMember.Level.Ordinal, 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Attrition Rate]
 AS IIF(
    ([Dim Status].[Status Name].[All], [Measures].[Fact HR Count]) = 0,
    NULL,
    Sum(
        {
            [Dim Status].[Status Name].[Resigned],
            [Dim Status].[Status Name].[Terminated]
        },
        [Measures].[Fact HR Count]
    )
    /
    ( [Dim Status].[Status Name].[All], [Measures].[Fact HR Count] )
), 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Salary &lt; 2 Years]
 AS Avg([Employees &lt; 2 Years], [Measures].[Salary INR]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Salary 2-4 Years]
 AS Avg([Employees 2-4 Years], [Measures].[Salary INR]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Avg Salary &gt; 4 Years]
 AS Avg([Employees &gt; 4 Years], [Measures].[Salary INR]), 
FORMAT_STRING = "#,##0.00;-#,##0.00", 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Employee Count Per Job]
 AS COUNT(
    NONEMPTY(
        [Dim Employee].[Full Name].Members,
        [Measures].[Fact HR Count]
    )
), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[Top10PercentCount]
 AS INT([Measures].[Employee Count Per Job] * 0.1), 
VISIBLE = 1  ; 
CREATE MEMBER CURRENTCUBE.[Measures].[High Performers High Earners Count]
 AS COUNT(
    INTERSECT(
        FILTER(
            NONEMPTY(
                [Dim Employee].[Full Name].Members,
                [Measures].[Fact HR Count]
            ),
            [Measures].[Performance Rating] = 5
        ),
        TOPCOUNT(
            NONEMPTY(
                [Dim Employee].[Full Name].Members,
                [Measures].[Fact HR Count]
            ),
            [Measures].[Top10PercentCount],
            [Measures].[Salary INR]
        )
    )
), 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>